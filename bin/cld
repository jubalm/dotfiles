#!/bin/bash
# Claude CLI wrapper script with granular MCP server support
# Usage: cld [OPTIONS] [-- CLAUDE_ARGS]
# Supports combining multiple MCPs:
#   cld -pc                          # Load individual servers by shorthand
#   cld -m playwright context7       # Load by name
#   cld -m dev                       # Load bundle config
#   cld -m dev playwright            # Mix bundle + individual

set -e

# ============================================================
#                     CONFIGURATION
# ============================================================

CLAUDE_COMMAND="claude"
SKIP_PERMISSIONS="--allow-dangerously-skip-permissions"
MCP_SERVER_DIR="${HOME}/.claude/servers"
PROVIDERS_FILE="${HOME}/.claude/providers.json"
PROVIDERS_EXAMPLE_FILE="${HOME}/.claude/providers.json.example"
TEMP_CONFIG=$(mktemp)

# Example provider configurations (used to scaffold ~/.claude/providers.json.example)
read -r -d '' EXAMPLE_PROVIDERS << 'PROVIDERS_EOF' || true
{
  "zai": {
    "env": {
      "ANTHROPIC_AUTH_TOKEN": "your-zai-api-key",
      "ANTHROPIC_BASE_URL": "https://api.z.ai/api/anthropic",
      "API_TIMEOUT_MS": "3000000",
      "ANTHROPIC_DEFAULT_HAIKU_MODEL": "glm-4.5-air",
      "ANTHROPIC_DEFAULT_SONNET_MODEL": "glm-4.7",
      "ANTHROPIC_DEFAULT_OPUS_MODEL": "glm-4.7"
    }
  },
  "ollama": {
    "env": {
      "ANTHROPIC_AUTH_TOKEN": "ollama",
      "ANTHROPIC_BASE_URL": "http://localhost:11434"
    },
    "model": "kimi-k2.5:cloud"
  }
}
PROVIDERS_EOF

# Enable LSP support by default
export ENABLE_LSP_TOOL=1

# Trap to clean up temp file on exit
trap "rm -f $TEMP_CONFIG" EXIT

# Map shorthand flag to server filename (without extension)
resolve_server_name() {
    case "$1" in
        p) echo "playwright" ;;
        c) echo "chrome-devtools" ;;
        x) echo "context7" ;;
        a) echo "astro-docs" ;;
        f) echo "figma" ;;
        *) return 1 ;;
    esac
}

# Find server config file (tries .json then .mcp.json)
find_server_file() {
    local name="$1"

    # Try .json first
    if [[ -f "${MCP_SERVER_DIR}/${name}.json" ]]; then
        echo "${MCP_SERVER_DIR}/${name}.json"
        return 0
    fi

    # Try .mcp.json
    if [[ -f "${MCP_SERVER_DIR}/${name}.mcp.json" ]]; then
        echo "${MCP_SERVER_DIR}/${name}.mcp.json"
        return 0
    fi

    return 1
}

# Create example providers file if it doesn't exist
create_example_providers() {
    if [[ ! -f "$PROVIDERS_EXAMPLE_FILE" ]]; then
        mkdir -p "$(dirname "$PROVIDERS_EXAMPLE_FILE")"
        echo "$EXAMPLE_PROVIDERS" > "$PROVIDERS_EXAMPLE_FILE"
        chmod 600 "$PROVIDERS_EXAMPLE_FILE"
    fi
}

# Load provider configuration from providers.json
load_provider() {
    local provider="$1"

    if [[ ! -f "$PROVIDERS_FILE" ]]; then
        create_example_providers
        echo "Error: Providers file not found at $PROVIDERS_FILE" >&2
        echo "Example created at: $PROVIDERS_EXAMPLE_FILE" >&2
        echo "Edit it with your API keys, then rename to providers.json:" >&2
        echo "  mv $PROVIDERS_EXAMPLE_FILE $PROVIDERS_FILE" >&2
        echo "See docs: https://code.claude.com/docs/en/settings" >&2
        return 1
    fi

    # Validate JSON
    if ! jq . "$PROVIDERS_FILE" > /dev/null 2>&1; then
        echo "Error: Invalid JSON in $PROVIDERS_FILE" >&2
        return 1
    fi

    # Check if provider exists
    if ! jq -e ".[\"$provider\"]" "$PROVIDERS_FILE" > /dev/null 2>&1; then
        echo "Error: Provider '$provider' not found in $PROVIDERS_FILE" >&2
        echo "Available providers:" >&2
        jq -r 'keys[]' "$PROVIDERS_FILE" | sed 's/^/  - /' >&2
        return 1
    fi

    # Extract and output the provider config
    jq ".[\"$provider\"]" "$PROVIDERS_FILE"
}

# List available providers
list_providers() {
    if [[ ! -f "$PROVIDERS_FILE" ]]; then
        create_example_providers
        echo "No providers configured yet."
        echo ""
        echo "Example file created at: $PROVIDERS_EXAMPLE_FILE"
        echo ""
        echo "To get started:"
        echo "  1. Edit: $PROVIDERS_EXAMPLE_FILE"
        echo "  2. Replace example values with your API keys"
        echo "  3. Rename: mv $PROVIDERS_EXAMPLE_FILE $PROVIDERS_FILE"
        echo ""
        echo "Documentation: https://code.claude.com/docs/en/settings"
        return 0
    fi

    if ! jq . "$PROVIDERS_FILE" > /dev/null 2>&1; then
        echo "Error: Invalid JSON in $PROVIDERS_FILE" >&2
        return 1
    fi

    local providers=($(jq -r 'keys[]' "$PROVIDERS_FILE"))

    if [[ ${#providers[@]} -eq 0 ]]; then
        echo "No providers configured in ~/.claude/providers.json"
        return 0
    fi

    echo "Available providers in ~/.claude/providers.json:"
    echo ""
    for provider in "${providers[@]}"; do
        echo "  - $provider"
    done
    echo ""
    echo "💡 To get started, copy the example:"
    echo "  cp ~/.claude/providers.json.example ~/.claude/providers.json"
    echo ""
    echo "Then edit ~/.claude/providers.json with your API keys and endpoints."
    echo "Example template: ~/.claude/providers.json.example"
}

# List available servers by scanning folder
list_servers() {
    if [[ ! -d "$MCP_SERVER_DIR" ]]; then
        echo "No servers directory found at $MCP_SERVER_DIR"
        return 1
    fi

    echo "Available servers (use with 'cld -m'):"
    echo ""

    shopt -s nullglob
    for file in "$MCP_SERVER_DIR"/*.json "$MCP_SERVER_DIR"/*.mcp.json; do
        local name=$(basename "$file" | sed 's/\.mcp\.json$//' | sed 's/\.json$//')
        echo "  - $name"
    done | sort -u
    shopt -u nullglob
}

# Merge JSON mcpServers sections from multiple files
merge_mcp_configs() {
    local merged='{
	"mcpServers": {}
}'

    for file in "$@"; do
        if [[ ! -f "$file" ]]; then
            echo "Error: MCP config not found: $file" >&2
            return 1
        fi

        # Extract mcpServers from each file and merge
        merged=$(jq -s '.[0] as $base | .[1:] | reduce .[] as $item (
            $base;
            .mcpServers += ($item.mcpServers // {})
        )' <(echo "$merged") "$file")
    done

    echo "$merged"
}

# ============================================================
#                     HELP TEXT
# ============================================================

show_help() {
    cat << 'EOF'
Claude CLI launcher with granular MCP server support and LSP enabled by default

USAGE:
    cld [OPTIONS] [-- CLAUDE_ARGS]

FEATURES:
    - LSP (Language Server Protocol) enabled by default for IDE-level code intelligence
    - Supports: Python, TypeScript, Go, Rust, Java, C/C++, C#, PHP, Kotlin, Ruby, HTML/CSS
    - Operations: goToDefinition, findReferences, hover, documentSymbol, getDiagnostics

COMMANDS:
    ls, list, --list          List available MCP servers
    providers                 List available API providers
    -h, --help                Show this help message

OPTIONS:
    -p PROVIDER               Use provider configuration from ~/.claude/providers.json
    -m SERVER [SERVER ...]    Load MCP servers by name or shorthand

SHORTHAND FLAGS (used with -m):
    p               Playwright browser automation
    c               Chrome DevTools
    x               Context7 (Upstash context)
    a               Astro documentation
    f               Figma design tools

NAMED SERVERS & BUNDLES:
    Available in: ~/.claude/servers/

    Individual Servers:
    - playwright         (shorthand: p)
    - chrome-devtools    (shorthand: c)
    - context7           (shorthand: x)
    - astro-docs         (shorthand: a)
    - figma              (shorthand: f)
    - cloudflare-docs

    Bundles (multiple servers in one):
    - dev               (chrome-devtools + context7)

EXAMPLES:
    cld                                    # Run Claude with no MCP
    cld -h, --help                         # Show this help

    Single servers:
    cld -m p                               # Load Playwright
    cld -m playwright                      # Load Playwright (full name)
    cld -m chrome-devtools                 # Load Chrome DevTools
    cld -m figma                           # Load Figma
    cld -m cloudflare-docs                 # Load Cloudflare Docs

    Multiple servers:
    cld -m p c                             # Load Playwright + Chrome DevTools
    cld -m p f                             # Load Playwright + Figma
    cld -m playwright context7 cloudflare-docs
    cld -m p x a f                         # Load Playwright + Context7 + Astro + Figma

    Bundles:
    cld -m dev                             # Load dev bundle (chrome-devtools + context7)
    cld -m dev cloudflare-docs             # Dev bundle + Cloudflare Docs
    cld -m p dev                           # Playwright + dev bundle

    With Claude args:
    cld -m dev -- --print "test"
    cld -m p x -- --print "compare"

    Provider switching:
    cld -p zai                             # Use Z.ai provider
    cld -p local                           # Use local endpoint
    cld -p zai -m dev                      # Z.ai + dev MCP bundle

    Setup providers:
    cp ~/.claude/providers.json.example ~/.claude/providers.json
    # Edit ~/.claude/providers.json with your API keys

EOF
}

# ============================================================
#                     MAIN SCRIPT
# ============================================================

declare -a MCP_FILES
CLAUDE_ARGS=()
USE_MCP_MODE=false
PROVIDER_NAME=""
PROVIDER_SETTINGS=""

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            exit 0
            ;;
        ls|list|--list)
            list_servers
            exit 0
            ;;
        providers)
            list_providers
            exit 0
            ;;
        -m)
            # -m mode: collect all following args until -- or end
            USE_MCP_MODE=true
            shift

            # Collect server names/shorthands until we hit -- or end
            while [[ $# -gt 0 && "$1" != "--" ]]; do
                arg="$1"

                # Check if it's a shorthand (single char)
                if [[ ${#arg} -eq 1 ]]; then
                    server_name=$(resolve_server_name "$arg")
                    if [[ -z "$server_name" ]]; then
                        echo "Error: Unknown shorthand '$arg'" >&2
                        show_help >&2
                        exit 1
                    fi
                else
                    # Use as-is (full server name or bundle name)
                    server_name="$arg"
                fi

                # Find the config file
                if ! file=$(find_server_file "$server_name"); then
                    echo "Error: Server or bundle not found: $server_name" >&2
                    echo "Available in: $MCP_SERVER_DIR/" >&2
                    ls -1 "$MCP_SERVER_DIR" | sed 's/\(.*\)\.\(json\|mcp\.json\)$/  - \1/' >&2
                    exit 1
                fi

                MCP_FILES+=("$file")
                shift
            done

            # Handle -- if present
            if [[ $# -gt 0 && "$1" == "--" ]]; then
                shift
                CLAUDE_ARGS=("$@")
            fi
            break
            ;;
        -p)
            if [[ -z "$2" ]]; then
                echo "Error: -p requires a provider name" >&2
                show_help >&2
                exit 1
            fi
            PROVIDER_NAME="$2"
            shift 2
            ;;
        --)
            # -- without -m: pass remaining to claude
            shift
            CLAUDE_ARGS=("$@")
            break
            ;;
        *)
            # Unknown args (shouldn't reach here without -m)
            echo "Error: Unknown argument: $1" >&2
            show_help >&2
            exit 1
            ;;
    esac
done

# ============================================================
#                  PROVIDER HANDLING
# ============================================================

# Load provider settings if specified
if [[ -n "$PROVIDER_NAME" ]]; then
    if ! PROVIDER_CONFIG=$(load_provider "$PROVIDER_NAME"); then
        exit 1
    fi

    # Extract env vars and export them
    while IFS= read -r line; do
        export "$line"
    done < <(jq -r '.env | to_entries | .[] | "\(.key)=\(.value)"' <<< "$PROVIDER_CONFIG")

    # Extract settings if present and add to Claude command
    if jq -e '.settings' <<< "$PROVIDER_CONFIG" > /dev/null 2>&1; then
        PROVIDER_SETTINGS=$(jq -c '.settings' <<< "$PROVIDER_CONFIG")
    fi
fi

# Build the command
CMD=("$CLAUDE_COMMAND" "$SKIP_PERMISSIONS")

# If MCP files are specified, merge and add them
if [[ ${#MCP_FILES[@]} -gt 0 ]]; then
    if ! MERGED_CONFIG=$(merge_mcp_configs "${MCP_FILES[@]}"); then
        exit 1
    fi

    # Write merged config to temp file
    echo "$MERGED_CONFIG" > "$TEMP_CONFIG"
    CMD+=(--mcp-config "$TEMP_CONFIG")
fi

# Add provider settings if present
if [[ -n "$PROVIDER_SETTINGS" ]]; then
    CMD+=(--settings "$PROVIDER_SETTINGS")
fi

# Add any additional Claude arguments
if [[ ${#CLAUDE_ARGS[@]} -gt 0 ]]; then
    CMD+=("${CLAUDE_ARGS[@]}")
fi

# Execute
exec "${CMD[@]}"
