#!/bin/bash
# Claude CLI wrapper script with granular MCP server support
# Usage: cld [OPTIONS] [-- CLAUDE_ARGS]
# Supports combining multiple MCPs:
#   cld -pc                          # Load individual servers by shorthand
#   cld -m playwright context7       # Load by name
#   cld -m dev                       # Load bundle config
#   cld -m dev playwright            # Mix bundle + individual

set -e

# ============================================================
#                     CONFIGURATION
# ============================================================

CLAUDE_COMMAND="claude"
SKIP_PERMISSIONS="--allow-dangerously-skip-permissions"
MCP_SERVER_DIR="${HOME}/.claude/servers"
TEMP_CONFIG=$(mktemp)

# Enable LSP support by default
export ENABLE_LSP_TOOL=1

# Trap to clean up temp file on exit
trap "rm -f $TEMP_CONFIG" EXIT

# Map shorthand flag to server filename (without extension)
resolve_server_name() {
    case "$1" in
        p) echo "playwright" ;;
        c) echo "chrome-devtools" ;;
        x) echo "context7" ;;
        a) echo "astro-docs" ;;
        f) echo "figma" ;;
        *) return 1 ;;
    esac
}

# Find server config file (tries .json then .mcp.json)
find_server_file() {
    local name="$1"

    # Try .json first
    if [[ -f "${MCP_SERVER_DIR}/${name}.json" ]]; then
        echo "${MCP_SERVER_DIR}/${name}.json"
        return 0
    fi

    # Try .mcp.json
    if [[ -f "${MCP_SERVER_DIR}/${name}.mcp.json" ]]; then
        echo "${MCP_SERVER_DIR}/${name}.mcp.json"
        return 0
    fi

    return 1
}

# List available servers by scanning folder
list_servers() {
    if [[ ! -d "$MCP_SERVER_DIR" ]]; then
        echo "No servers directory found at $MCP_SERVER_DIR"
        return 1
    fi

    echo "Available servers (use with 'cld -m'):"
    echo ""

    shopt -s nullglob
    for file in "$MCP_SERVER_DIR"/*.json "$MCP_SERVER_DIR"/*.mcp.json; do
        local name=$(basename "$file" | sed 's/\.mcp\.json$//' | sed 's/\.json$//')
        echo "  - $name"
    done | sort -u
    shopt -u nullglob
}

# Merge JSON mcpServers sections from multiple files
merge_mcp_configs() {
    local merged='{
	"mcpServers": {}
}'

    for file in "$@"; do
        if [[ ! -f "$file" ]]; then
            echo "Error: MCP config not found: $file" >&2
            return 1
        fi

        # Extract mcpServers from each file and merge
        merged=$(jq -s '.[0] as $base | .[1:] | reduce .[] as $item (
            $base;
            .mcpServers += ($item.mcpServers // {})
        )' <(echo "$merged") "$file")
    done

    echo "$merged"
}

# ============================================================
#                     HELP TEXT
# ============================================================

show_help() {
    cat << 'EOF'
Claude CLI launcher with granular MCP server support and LSP enabled by default

USAGE:
    cld [OPTIONS] [-- CLAUDE_ARGS]

FEATURES:
    - LSP (Language Server Protocol) enabled by default for IDE-level code intelligence
    - Supports: Python, TypeScript, Go, Rust, Java, C/C++, C#, PHP, Kotlin, Ruby, HTML/CSS
    - Operations: goToDefinition, findReferences, hover, documentSymbol, getDiagnostics

COMMANDS:
    ls, list, --list          List available servers
    -h, --help                Show this help message

OPTIONS:
    -m SERVER [SERVER ...]    Load MCP servers by name or shorthand

SHORTHAND FLAGS (used with -m):
    p               Playwright browser automation
    c               Chrome DevTools
    x               Context7 (Upstash context)
    a               Astro documentation
    f               Figma design tools

NAMED SERVERS & BUNDLES:
    Available in: ~/.claude/servers/

    Individual Servers:
    - playwright         (shorthand: p)
    - chrome-devtools    (shorthand: c)
    - context7           (shorthand: x)
    - astro-docs         (shorthand: a)
    - figma              (shorthand: f)
    - cloudflare-docs

    Bundles (multiple servers in one):
    - dev               (chrome-devtools + context7)

EXAMPLES:
    cld                                    # Run Claude with no MCP
    cld -h, --help                         # Show this help

    Single servers:
    cld -m p                               # Load Playwright
    cld -m playwright                      # Load Playwright (full name)
    cld -m chrome-devtools                 # Load Chrome DevTools
    cld -m figma                           # Load Figma
    cld -m cloudflare-docs                 # Load Cloudflare Docs

    Multiple servers:
    cld -m p c                             # Load Playwright + Chrome DevTools
    cld -m p f                             # Load Playwright + Figma
    cld -m playwright context7 cloudflare-docs
    cld -m p x a f                         # Load Playwright + Context7 + Astro + Figma

    Bundles:
    cld -m dev                             # Load dev bundle (chrome-devtools + context7)
    cld -m dev cloudflare-docs             # Dev bundle + Cloudflare Docs
    cld -m p dev                           # Playwright + dev bundle

    With Claude args:
    cld -m dev -- --print "test"
    cld -m p x -- --print "compare"

EOF
}

# ============================================================
#                     MAIN SCRIPT
# ============================================================

declare -a MCP_FILES
CLAUDE_ARGS=()
USE_MCP_MODE=false

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            exit 0
            ;;
        ls|list|--list)
            list_servers
            exit 0
            ;;
        -m)
            # -m mode: collect all following args until -- or end
            USE_MCP_MODE=true
            shift

            # Collect server names/shorthands until we hit -- or end
            while [[ $# -gt 0 && "$1" != "--" ]]; do
                arg="$1"

                # Check if it's a shorthand (single char)
                if [[ ${#arg} -eq 1 ]]; then
                    server_name=$(resolve_server_name "$arg")
                    if [[ -z "$server_name" ]]; then
                        echo "Error: Unknown shorthand '$arg'" >&2
                        show_help >&2
                        exit 1
                    fi
                else
                    # Use as-is (full server name or bundle name)
                    server_name="$arg"
                fi

                # Find the config file
                if ! file=$(find_server_file "$server_name"); then
                    echo "Error: Server or bundle not found: $server_name" >&2
                    echo "Available in: $MCP_SERVER_DIR/" >&2
                    ls -1 "$MCP_SERVER_DIR" | sed 's/\(.*\)\.\(json\|mcp\.json\)$/  - \1/' >&2
                    exit 1
                fi

                MCP_FILES+=("$file")
                shift
            done

            # Handle -- if present
            if [[ $# -gt 0 && "$1" == "--" ]]; then
                shift
                CLAUDE_ARGS=("$@")
            fi
            break
            ;;
        --)
            # -- without -m: pass remaining to claude
            shift
            CLAUDE_ARGS=("$@")
            break
            ;;
        *)
            # Unknown args (shouldn't reach here without -m)
            echo "Error: Unknown argument: $1" >&2
            show_help >&2
            exit 1
            ;;
    esac
done

# Build the command
CMD=("$CLAUDE_COMMAND" "$SKIP_PERMISSIONS")

# If MCP files are specified, merge and add them
if [[ ${#MCP_FILES[@]} -gt 0 ]]; then
    if ! MERGED_CONFIG=$(merge_mcp_configs "${MCP_FILES[@]}"); then
        exit 1
    fi

    # Write merged config to temp file
    echo "$MERGED_CONFIG" > "$TEMP_CONFIG"
    CMD+=(--mcp-config "$TEMP_CONFIG")
fi

# Add any additional Claude arguments
if [[ ${#CLAUDE_ARGS[@]} -gt 0 ]]; then
    CMD+=("${CLAUDE_ARGS[@]}")
fi

# Execute
exec "${CMD[@]}"
