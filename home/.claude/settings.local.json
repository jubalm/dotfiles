{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(* --help)",
      "Bash(* --version)",
      "Bash(ls *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(npm i)",
      "Bash(npm install)",
      "Bash(npm run build)",
      "mcp__context7",
      "mcp__playwright",
      "mcp__chrome-devtools",
      "mcp__cloudflare-docs",
      "mcp__figma",
      "mcp__shadcn"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "default"
  },
  "model": "haiku",
  "effortLevel": "low",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  }
}
