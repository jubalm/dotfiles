{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "mcp__context7",
      "mcp__playwright",
      "mcp__chrome-devtools",
      "mcp__cloudflare-docs",
      "mcp__figma",
      "mcp__shadcn"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "default"
  },
  "model": "haiku",
  "effortLevel": "low",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  }
}
