      "Bash(git rev-list *)",
      "Bash(git ls-files *)",
      "Bash(git ls-tree *)",
      "Bash(git config *)",
      "Bash(git --version)",
      "Bash(git help *)",
      "Bash(gh --version)",
      "Bash(gh help *)",
      "Bash(gh repo view *)",
      "Bash(gh repo list *)",
